{
  "ci": {
    "collect": {
      "startServerCommand": "python3 -m http.server 8000",
      "url": ["http://localhost:8000/"],
      "numberOfRuns": 1
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 0.9 }]
      }
    },
    "upload": { "target": "filesystem", "outputDir": "./lhci-report" }
  }
}
